# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Configuration
PORT="3000"
NODE_ENV="development"
JWT_SECRET="zeropass_dev_jwt_secret_minimum_32_characters_for_security_hs256"

# Database Configuration
# Local SQLite for sandbox: file:./dev.db
# Production PostgreSQL: postgresql://postgres:postgres@localhost:5432/zeropass?schema=public
DATABASE_URL="file:./dev.db"

# Cryptographic Keys (Ed25519 / BLS12-381)
ISSUER_DID="did:zeropass:testnet:helios:reg78912"

# DigiLocker Integration (Sandbox / Production Provider API Setu)
DIGILOCKER_ENABLED="false"
DIGILOCKER_CLIENT_ID="MY_DIGILOCKER_CLIENT_ID"
DIGILOCKER_CLIENT_SECRET="MY_DIGILOCKER_CLIENT_SECRET"
DIGILOCKER_REDIRECT_URI="http://localhost:3000/api/providers/digilocker/callback"

# Optional Blockchain Registry (Polygon Amoy / Ethereum Sepolia)
BLOCKCHAIN_ENABLED="false"
BLOCKCHAIN_RPC_URL="https://rpc-amoy.polygon.technology"
BLOCKCHAIN_REGISTRY_ADDRESS="0x0000000000000000000000000000000000000000"

